<Application x:Class="RevivalRevolution.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#090B10"/>
  <SolidColorBrush x:Key="Panel" Color="#121722"/>
  <SolidColorBrush x:Key="Accent" Color="#E53945"/>
  <SolidColorBrush x:Key="Muted" Color="#9AA4B5"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#242B38"/>
   <Setter Property="BorderBrush" Value="#343D4D"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>