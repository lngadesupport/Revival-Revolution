<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RevivalRevolution</AssemblyName>
    <Version>0.7.2</Version>
    <AssemblyVersion>0.7.2.0</AssemblyVersion>
    <FileVersion>0.7.2.0</FileVersion>
    <RootNamespace>RevivalRevolution</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/BebasNeue-Regular.ttf" />
    <Content Include="Assets/metal-revolution-background.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets/metal-revolution-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Legacy offline bootstrap scripts are supplied manually before packaging. -->
    <Content Include="OfflineScripts/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="launcher-update.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateOfflineDistributionScripts" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('OfflineScripts/offline_launcher.py')"
           Text="Offline distribution incomplete: OfflineScripts/offline_launcher.py is missing." />
    <Error Condition="!Exists('OfflineScripts/inject_offline.py')"
           Text="Offline distribution incomplete: OfflineScripts/inject_offline.py is missing." />
    <Error Condition="!Exists('OfflineScripts/inject_overlay.py')"
           Text="Offline distribution incomplete: OfflineScripts/inject_overlay.py is missing." />
  </Target>
</Project>