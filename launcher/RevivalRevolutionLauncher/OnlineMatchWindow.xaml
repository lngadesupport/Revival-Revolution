<UserControl x:Class="RevivalRevolution.OnlineMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#090B10" Foreground="#F4F2F0"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#E10D111A"/>
        <SolidColorBrush x:Key="Muted" Color="#9DA5B3"/>
        <SolidColorBrush x:Key="Accent" Color="#E34450"/>
        <SolidColorBrush x:Key="Line" Color="#394252"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F3F1"/>
            <Setter Property="Background" Value="#252D39"/>
            <Setter Property="BorderBrush" Value="#465163"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#344052"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#68778C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#4A252D"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E34450"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151A23"/>
            <Setter Property="Foreground" Value="#F5F3F1"/>
            <Setter Property="BorderBrush" Value="#3D4756"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MULTIPLAYER  /  CONEXÃO PRIVADA" Foreground="{StaticResource Accent}"
                           FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="Sala por código" FontSize="32" FontWeight="Bold" Margin="0,3,0,1"/>
                <TextBlock Text="Uma partida entre você e alguém que você escolheu."
                           Foreground="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#D1121721" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="11,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="34" Height="34" Margin="0,0,9,0">
                        <Ellipse x:Name="MyAvatarCircle" Fill="#343B4A" Stroke="#778294" StrokeThickness="1"/>
                        <TextBlock x:Name="MyAvatarInitials" Text="RR" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" MinWidth="115">
                        <TextBlock x:Name="MyNicknameText" Text="Jogador" FontWeight="Bold" FontSize="11"/>
                        <TextBlock x:Name="ProfileText" Text="Conta não conectada"
                                   Foreground="{StaticResource Muted}" FontSize="9"/>
                    </StackPanel>
                    <Button x:Name="AvatarButton" Content="FOTO" Click="Avatar_Click" IsEnabled="False"
                            Padding="8,6" Margin="8,0,0,0" FontSize="8"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="2" Content="VOLTAR AO INÍCIO" Click="Back_Click" Margin="10,0,0,0"
                    Padding="12,10" VerticalAlignment="Center" Background="#1B222D"
                    BorderBrush="#394252" FontSize="9"/>
        </Grid>

        <Border Grid.Row="1" Background="#D10D111A" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="REDE PRIVADA" Foreground="{StaticResource Muted}"
                               FontSize="8" FontWeight="Bold"/>
                    <TextBlock Text="Radmin VPN  /  endpoint configurado" FontSize="11"
                               FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="NICKNAME" Foreground="{StaticResource Muted}"
                           FontSize="8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NicknameBox" MaxLength="32" VerticalContentAlignment="Center"
                             FontSize="11" Padding="9,7"/>
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="CONECTAR"
                            Click="Connect_Click" Padding="11,7" Margin="7,0,0,0" FontSize="9"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="InvitePanel" Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                    Padding="22" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="01  /  ANFITRIÃO" Foreground="{StaticResource Accent}"
                                   FontSize="8" FontWeight="Bold"/>
                        <TextBlock Text="Criar uma sala" FontSize="23" FontWeight="Bold" Margin="0,5,0,3"/>
                        <TextBlock Text="Gere um convite privado e compartilhe o código com seu adversário."
                                   Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#161B25" BorderBrush="#394252"
                            BorderThickness="1" CornerRadius="8" Padding="18"
                            VerticalAlignment="Center" Margin="0,15,0,15">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CÓDIGO DA SUA SALA" Foreground="{StaticResource Muted}"
                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBox x:Name="RoomCodeDisplayBox" IsReadOnly="True" Text="------"
                                     FontSize="29" FontWeight="Bold" HorizontalContentAlignment="Center"
                                     TextAlignment="Center" Margin="0,10,0,10" Padding="12"
                                     Background="#0E121A" BorderBrush="#4A5668"/>
                            <Button x:Name="CreateRoomButton" Content="CRIAR NOVO CONVITE"
                                    Click="CreateRoom_Click" IsEnabled="False"
                                    Background="#D93645" BorderBrush="#F36A72"
                                    Padding="14,13" HorizontalContentAlignment="Center"/>
                            <Button x:Name="CopyRoomCodeButton" Content="COPIAR CÓDIGO"
                                    Click="CopyRoomCode_Click" IsEnabled="False"
                                    Margin="0,5,0,0" Background="#242C38"
                                    HorizontalContentAlignment="Center"/>
                            <Button x:Name="CancelRoomButton" Content="CANCELAR CONVITE"
                                    Click="CancelRoom_Click" IsEnabled="False" Visibility="Collapsed"
                                    HorizontalAlignment="Center" Background="Transparent"
                                    BorderThickness="0" Padding="10,5"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="O código só fica disponível enquanto o convite estiver ativo."
                               Foreground="#7F8998" FontSize="9" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="22" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="02  /  CONVIDADO" Foreground="{StaticResource Accent}"
                                   FontSize="8" FontWeight="Bold"/>
                        <TextBlock Text="Entrar em uma sala" FontSize="23" FontWeight="Bold" Margin="0,5,0,3"/>
                        <TextBlock Text="Recebeu um código? Informe abaixo para encontrar o anfitrião."
                                   Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                        <TextBlock Text="CÓDIGO DE CONVITE" Foreground="{StaticResource Muted}"
                                   FontSize="8" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="RoomCodeBox" MaxLength="8" CharacterCasing="Upper"
                                 TextAlignment="Center" FontSize="24" FontWeight="Bold"
                                 VerticalContentAlignment="Center" Padding="14,13"
                                 ToolTip="Código de 6 caracteres"/>
                        <Button x:Name="JoinRoomButton" Content="ENTRAR NA SALA"
                                Click="JoinRoom_Click" IsEnabled="False" Margin="0,12,0,0"
                                Background="#D93645" BorderBrush="#F36A72"
                                Padding="14,13" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#171D27" BorderBrush="#303A49"
                            BorderThickness="1" CornerRadius="6" Padding="11">
                        <TextBlock Text="DICA  /  Confira se você e seu amigo estão conectados à mesma rede Radmin."
                                   Foreground="#929CAB" FontSize="9" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="VersusPanel" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="#F00D111A" BorderBrush="#505C6D" BorderThickness="1"
                    CornerRadius="10" Padding="25">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="SEU PERFIL" Foreground="{StaticResource Muted}" FontSize="9"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Grid Width="140" Height="140">
                                <Ellipse x:Name="MyVersusAvatarCircle" Fill="#343B4A"
                                         Stroke="#E34450" StrokeThickness="3"/>
                                <TextBlock x:Name="MyVersusAvatarInitials" Text="RR" FontSize="40"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="MyVersusNicknameText" Text="Você" FontSize="20"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                            <TextBlock x:Name="MyVersusRoleText" Text="ANFITRIÃO"
                                       Foreground="{StaticResource Accent}" FontSize="8"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                            <TextBlock Text="VS" FontSize="44" FontWeight="Black"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            <Border Height="1" Width="55" Background="#687384" Margin="0,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ADVERSÁRIO" Foreground="{StaticResource Muted}" FontSize="9"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Grid Width="140" Height="140">
                                <Ellipse x:Name="OpponentAvatarCircle" Fill="#343B4A"
                                         Stroke="#778294" StrokeThickness="3"/>
                                <TextBlock x:Name="OpponentAvatarInitials" Text="??" FontSize="40"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="OpponentNicknameText" Text="Aguardando jogador"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                            <TextBlock x:Name="OpponentRoleText" Text="CONVIDADO"
                                       Foreground="{StaticResource Muted}" FontSize="8"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="400" Margin="0,16,0,0">
                        <TextBlock x:Name="VersusStateText" Text="Os dois jogadores estão na sala."
                                   Foreground="{StaticResource Muted}" FontSize="10"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <Button x:Name="StartRoomButton" Content="INICIAR PARTIDA"
                                Click="StartRoom_Click" IsEnabled="False" Visibility="Collapsed"
                                Background="#D93645" BorderBrush="#F36A72" Padding="18,14"
                                FontSize="16" HorizontalContentAlignment="Center"/>
                        <Button x:Name="LeaveRoomButton" Content="SAIR DA SALA"
                                Click="DeclineMatch_Click" IsEnabled="False"
                                Background="Transparent" BorderThickness="0"
                                Padding="10,6" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#C70D111A" BorderBrush="#303A49"
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <DockPanel>
                <Ellipse Width="6" Height="6" Fill="#E34450" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="Conecte-se para criar ou entrar em uma sala privada."
                           Foreground="#AAB3C0" FontSize="9" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>