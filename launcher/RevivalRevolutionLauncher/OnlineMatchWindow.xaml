<Window x:Class="RevivalRevolution.OnlineMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revival Revolution — Private Match" Height="760" Width="1080"
        MinHeight="680" MinWidth="900" WindowStartupLocation="CenterOwner"
        Background="#080911" Foreground="#FFFFFF" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#B00A0B18"/>
        <SolidColorBrush x:Key="Muted" Color="#C5C4D2"/>
        <SolidColorBrush x:Key="Accent" Color="#FFE04A58"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#76202A40"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#7F080A13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="REVIVAL REVOLUTION / PRIVATE MATCH" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="PARTIDA PRIVADA" FontSize="34" FontWeight="Black" Margin="0,3,0,0"/>
                <TextBlock Text="Convide um jogador ou entre usando o código da sala." Foreground="{StaticResource Muted}" FontSize="13"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#99101420" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="42" Height="42" Margin="0,0,10,0">
                        <Ellipse x:Name="MyAvatarCircle" Fill="#FF34394D" Stroke="#88FFFFFF" StrokeThickness="1"/>
                        <TextBlock x:Name="MyAvatarInitials" Text="RR" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Black"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" MinWidth="150">
                        <TextBlock x:Name="MyNicknameText" Text="Jogador" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="ProfileText" Text="Conta não conectada" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </StackPanel>
                    <Button x:Name="AvatarButton" Content="FOTO" Click="Avatar_Click" IsEnabled="False" Padding="10,8" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SERVIDOR PRIVADO • RADMIN VPN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="http://26.226.57.19:8765" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="NICKNAME" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NicknameBox" MaxLength="32" VerticalContentAlignment="Center" FontSize="12" Padding="9,7"/>
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="CONECTAR" Click="Connect_Click" Padding="12,7" Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border x:Name="InvitePanel" Background="{StaticResource Panel}" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="16" Padding="28">
                <Grid MaxWidth="760" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,14">
                        <TextBlock Text="ENCONTRE SEU OPONENTE" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="CRIAR CONVITE" FontSize="29" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,3"/>
                        <TextBlock Text="Gere um código exclusivo e envie ao jogador que deseja enfrentar." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#66101420" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="MATCHMAKING • SA-EAST / RADMIN VPN" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="CasualSearchButton" Content="BUSCA CASUAL" Click="QueueSearch_Click" Tag="casual" IsEnabled="False" Background="#76202A40"/>
                                <Button x:Name="RankedSearchButton" Grid.Column="1" Content="BUSCA RANQUEADA BETA" Click="QueueSearch_Click" Tag="ranked" IsEnabled="False" Margin="8,5,0,5" Background="#C52B1F30" BorderBrush="#FFFF6671"/>
                                <Button x:Name="CancelQueueButton" Grid.Column="2" Content="CANCELAR" Click="CancelQueue_Click" IsEnabled="False" Margin="8,5,0,5" Padding="10,8"/>
                            </Grid>
                            <TextBlock x:Name="QueueStateText" Text="Busca ranqueada em beta: matchmaking e conexão Radmin disponíveis, mas ELO e resultados competitivos estão desativados. Os jogadores precisam estar na mesma rede Radmin." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="LeaderboardRefreshButton" Content="LEADERBOARD DESATIVADO" Click="LeaderboardRefresh_Click" IsEnabled="False" Padding="10,7" Margin="0,0,10,0"/>
                                <TextBlock x:Name="LeaderboardStatusText" Grid.Column="1" Text="ELO e leaderboard desativados até existir validação independente dos resultados." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <ListBox x:Name="LeaderboardList" Height="76" Margin="0,6,0,0" Background="#55080A13" Foreground="White" BorderBrush="#44FFFFFF" FontSize="10" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#66161A2A" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SEU CÓDIGO DE CONVITE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBox x:Name="RoomCodeDisplayBox" IsReadOnly="True" Text="------" FontSize="30" FontWeight="Black" HorizontalContentAlignment="Center" TextAlignment="Center" Margin="0,10,0,8" Padding="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="CreateRoomButton" Content="CRIAR SALA" Click="CreateRoom_Click" IsEnabled="False" Background="#C52B1F30" BorderBrush="#FFFF6671" Padding="14,13"/>
                                <Button x:Name="CopyRoomCodeButton" Grid.Column="1" Content="COPIAR CÓDIGO" Click="CopyRoomCode_Click" IsEnabled="False" Margin="8,5,0,5" Padding="14,13"/>
                            </Grid>
                            <Button x:Name="CancelRoomButton" Content="CANCELAR CONVITE" Click="CancelRoom_Click" IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Height="1" Background="#55FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="OU ENTRE COM UM CÓDIGO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="14,0"/>
                        <Border Grid.Column="2" Height="1" Background="#55FFFFFF" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RoomCodeBox" MaxLength="8" CharacterCasing="Upper" TextAlignment="Center" FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center" ToolTip="Código de 6 caracteres"/>
                        <Button x:Name="JoinRoomButton" Grid.Column="1" Content="ENTRAR NA SALA" Click="JoinRoom_Click" IsEnabled="False" Margin="10,5,0,5" Background="#C52B1F30" BorderBrush="#FFFF6671"/>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="VersusPanel" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="16" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="SEU PERFIL" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <Grid Width="176" Height="176">
                                <Ellipse x:Name="MyVersusAvatarCircle" Fill="#FF34394D" Stroke="#FFFF6671" StrokeThickness="3"/>
                                <TextBlock x:Name="MyVersusAvatarInitials" Text="RR" FontSize="48" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="MyVersusNicknameText" Text="Você" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="MyVersusRoleText" Text="ANFITRIÃO" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0">
                            <TextBlock Text="VS" FontSize="52" FontWeight="Black" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            <Border Height="2" Width="70" Background="#88FFFFFF" Margin="0,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ADVERSÁRIO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <Grid Width="176" Height="176">
                                <Ellipse x:Name="OpponentAvatarCircle" Fill="#FF34394D" Stroke="#88FFFFFF" StrokeThickness="3"/>
                                <TextBlock x:Name="OpponentAvatarInitials" Text="??" FontSize="48" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="OpponentNicknameText" Text="Aguardando jogador" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="OpponentRoleText" Text="CONVIDADO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="420" Margin="0,18,0,0">
                        <TextBlock x:Name="VersusStateText" Text="Os dois jogadores estão na sala." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                        <Button x:Name="StartRoomButton" Content="INICIAR PARTIDA" Click="StartRoom_Click" IsEnabled="False" Visibility="Collapsed" Background="#D52B1F30" BorderBrush="#FFFF6671" Padding="18,16" FontSize="20" HorizontalContentAlignment="Center"/>
                        <Button x:Name="LeaveRoomButton" Content="SAIR DA SALA" Click="DeclineMatch_Click" IsEnabled="False" Background="Transparent" BorderThickness="0" Padding="10,6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Conecte-se para criar ou entrar em uma sala privada." Foreground="#D0CED8" FontSize="11" Margin="2,14,2,0" TextWrapping="Wrap"/>
    </Grid>
</Window>