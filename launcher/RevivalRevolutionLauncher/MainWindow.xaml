<Window x:Class="RevivalRevolution.MainWindow"
        StateChanged="MainWindow_StateChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revival Revolution" Height="860" Width="1480"
        MinHeight="720" MinWidth="1120" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#090B10" Foreground="#F4F2F0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#E510131B"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#B8141822"/>
        <SolidColorBrush x:Key="Line" Color="#343B49"/>
        <SolidColorBrush x:Key="Muted" Color="#9DA5B3"/>
        <SolidColorBrush x:Key="Accent" Color="#E34450"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F3F1"/>
            <Setter Property="Background" Value="#202631"/>
            <Setter Property="BorderBrush" Value="#394252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303947"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#687487"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A252D"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E34450"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D93645"/>
            <Setter Property="BorderBrush" Value="#F36A72"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="26,15"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171B24"/>
            <Setter Property="Foreground" Value="#F5F3F1"/>
            <Setter Property="BorderBrush" Value="#3A4352"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Image x:Name="HeroBackground" Stretch="UniformToFill" Opacity="0.58"/>
        <Rectangle Fill="#A4080A10"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F006080D" Offset="0"/>
                    <GradientStop Color="#B70A0D15" Offset="0.48"/>
                    <GradientStop Color="#F00A0B10" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Width="3" Margin="0,0,0,0" Fill="#D93645" Opacity="0.9"/>

        <Grid x:Name="MainContent" Margin="28,66,28,28" Opacity="0" Loaded="MainContent_Loaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0" Opacity="0" Background="#F00D1018"
                    BorderBrush="#343B49" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="5,5,5,24">
                        <TextBlock Text="REVIVAL" FontSize="27" FontWeight="Black"
                                   FontFamily="pack://application:,,,/Assets/Fonts/#Bebas Neue"
                                   Foreground="#F5F3F1"/>
                        <TextBlock Text="REVOLUTION  /  COMMUNITY" FontSize="8" FontWeight="Bold"
                                   Foreground="#E76A73" Margin="1,-2,0,0"/>
                        <Border Height="1" Background="#343B49" Margin="0,19,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="JOGAR" FontSize="9" FontWeight="Bold" Foreground="#737E8E"
                                       Margin="7,0,0,8"/>
                            <Button x:Name="OfflineNavButton" Style="{StaticResource NavButton}"
                                    Content="01   Modo offline" Click="Launch_Click" FontSize="13"/>
                            <Button x:Name="PrivateMatchNavButton" Style="{StaticResource NavButton}"
                                    Content="02   Sala por código" Click="PrivateMatch_Click" FontSize="13"/>
                            <Border Height="1" Background="#2D3542" Margin="5,17,5,16"/>
                            <TextBlock Text="COMUNIDADE" FontSize="9" FontWeight="Bold" Foreground="#737E8E"
                                       Margin="7,0,0,8"/>
                            <Button x:Name="ModListNavButton" Style="{StaticResource NavButton}"
                                    Content="03   Biblioteca de mods" Click="ModList_Click" FontSize="12"/>
                            <Border Height="1" Background="#2D3542" Margin="5,17,5,16"/>
                            <TextBlock Text="SISTEMA" FontSize="9" FontWeight="Bold" Foreground="#737E8E"
                                       Margin="7,0,0,8"/>
                            <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButton}"
                                    Content="04   Diagnósticos" Click="Diagnostics_Click"/>
                            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}"
                                    Content="05   Configurações" Click="Settings_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="3,18,3,2">
                        <Border Height="1" Background="#343B49" Margin="0,0,0,14"/>
                        <Button Content="ABRIR DISCORD" Click="Discord_Click" HorizontalContentAlignment="Center"
                                Background="#222B39" BorderBrush="#3D4A5E" Margin="0"/>
                        <TextBlock Text="FEITO PARA A COMUNIDADE" FontSize="8" FontWeight="Bold"
                                   Foreground="#667181" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel x:Name="HeaderPanel" Grid.Row="0" Opacity="0" LastChildFill="False"
                               Margin="2,0,2,18">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="CENTRAL DE OPERAÇÕES" FontSize="9" FontWeight="Bold"
                                       Foreground="#E76A73"/>
                            <TextBlock Text="Bem-vindo de volta." FontSize="22" FontWeight="SemiBold"
                                       Foreground="#F5F3F1" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#B811151E" BorderBrush="#394252" BorderThickness="1"
                                    CornerRadius="5" Padding="10,7" VerticalAlignment="Center" Margin="0,0,13,0">
                                <TextBlock x:Name="VersionLabel" FontSize="10" FontWeight="Bold"
                                           Foreground="#C5CBD4"/>
                            </Border>
                            <Image x:Name="MetalLogo" Width="145" Height="48" Stretch="Uniform" Visibility="Collapsed"/>
                            <StackPanel x:Name="LogoFallback" VerticalAlignment="Center">
                                <TextBlock Text="METAL" FontSize="26" FontWeight="Black"
                                           FontFamily="pack://application:,,,/Assets/Fonts/#Bebas Neue"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="REVOLUTION" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="#AAB2BF" Margin="0,-3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="0.88*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="HeroPanel" Grid.Column="0" Opacity="0" Background="#D90C1018"
                                BorderBrush="#414A59" BorderThickness="1" CornerRadius="12"
                                Padding="30" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#3B20262F" BorderBrush="#67515A66"
                                                BorderThickness="1" CornerRadius="3" Padding="8,4">
                                            <TextBlock Text="COMMUNITY BUILD" FontSize="8" FontWeight="Bold"
                                                       Foreground="#D9DDE3"/>
                                        </Border>
                                        <TextBlock Text="  /  METAL REVOLUTION" FontSize="9" FontWeight="Bold"
                                                   Foreground="#9DA5B3" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="A arena é sua." FontSize="43" FontWeight="Black"
                                               FontFamily="pack://application:,,,/Assets/Fonts/#Bebas Neue"
                                               Foreground="#FFFFFF" Margin="0,15,0,1"/>
                                    <TextBlock Text="Entre em combate. Reúna seus amigos.\nConstrua sua própria experiência."
                                               FontSize="13" LineHeight="21" Foreground="#B6BEC9"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,22,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#82171D27" BorderBrush="#3B4554" BorderThickness="1"
                                            CornerRadius="8" Padding="15" Margin="0,0,7,0">
                                        <StackPanel>
                                            <TextBlock Text="01  /  EXPERIÊNCIA" FontSize="8" FontWeight="Bold"
                                                       Foreground="#E76A73"/>
                                            <TextBlock Text="Modo offline" FontSize="18" FontWeight="SemiBold"
                                                       Margin="0,7,0,3"/>
                                            <TextBlock Text="Inicie o jogo usando a distribuição local já configurada."
                                                       FontSize="10" Foreground="#AAB2BF" TextWrapping="Wrap"
                                                       LineHeight="16"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#82171D27" BorderBrush="#3B4554"
                                            BorderThickness="1" CornerRadius="8" Padding="15" Margin="7,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="02  /  MULTIPLAYER" FontSize="8" FontWeight="Bold"
                                                       Foreground="#E76A73"/>
                                            <TextBlock Text="Sala por código" FontSize="18" FontWeight="SemiBold"
                                                       Margin="0,7,0,3"/>
                                            <TextBlock Text="Crie um convite privado ou conecte-se usando o código de outro jogador."
                                                       FontSize="10" Foreground="#AAB2BF" TextWrapping="Wrap"
                                                       LineHeight="16"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <DockPanel Grid.Row="2" LastChildFill="False">
                                    <TextBlock Text="SELECIONE SUA INSTALAÇÃO PARA COMEÇAR"
                                               FontSize="8" FontWeight="Bold" Foreground="#818C9C"
                                               VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="COMMUNITY EDITION"
                                               FontSize="9" FontWeight="Bold" Foreground="#697586"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="QuickAccessPanel" Grid.Column="1" Opacity="0"
                                Background="#E10D111A" BorderBrush="#414A59" BorderThickness="1"
                                CornerRadius="12" Padding="19">
                            <StackPanel>
                                <TextBlock Text="STATUS DO SISTEMA" FontSize="9" FontWeight="Bold"
                                           Foreground="#E76A73"/>
                                <TextBlock Text="Sua instalação" FontSize="20" FontWeight="SemiBold"
                                           Margin="0,5,0,15"/>
                                <Border Background="#171C26" BorderBrush="#394252" BorderThickness="1"
                                        CornerRadius="7" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="ESTADO ATUAL" FontSize="8" FontWeight="Bold"
                                                   Foreground="#828D9D"/>
                                        <TextBlock x:Name="DashboardLocalStatus" Text="NÃO CONFIGURADA"
                                                   FontSize="17" FontWeight="Bold" Foreground="#D4D9E0"
                                                   Margin="0,5,0,2"/>
                                        <TextBlock Text="O launcher verifica a pasta selecionada antes de liberar o jogo."
                                                   FontSize="9" Foreground="#9DA5B3" TextWrapping="Wrap"
                                                   LineHeight="15"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="LOCALIZAR INSTALAÇÃO" Click="ChooseFolder_Click"
                                        HorizontalContentAlignment="Center" FontSize="10"
                                        Background="#303947" BorderBrush="#596578" Padding="10,12"
                                        Margin="0,13,0,3"/>
                                <Button Content="EXECUTAR DIAGNÓSTICO" Click="Diagnostics_Click"
                                        HorizontalContentAlignment="Center" FontSize="10"
                                        Background="Transparent" BorderBrush="#394252" Padding="10,11"
                                        Margin="0,3,0,0"/>
                                <Border Height="1" Background="#303846" Margin="0,16,0,13"/>
                                <TextBlock Text="RECURSOS" FontSize="8" FontWeight="Bold"
                                           Foreground="#828D9D"/>
                                <StackPanel Margin="0,9,0,0">
                                    <DockPanel Margin="0,4">
                                        <Ellipse Width="6" Height="6" Fill="#6BC58B" Margin="0,0,9,0"/>
                                        <TextBlock Text="Inicialização offline" FontSize="10" Foreground="#D0D5DC"/>
                                        <TextBlock Text="ATIVO" DockPanel.Dock="Right" FontSize="8"
                                                   FontWeight="Bold" Foreground="#6BC58B"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,7">
                                        <Ellipse Width="6" Height="6" Fill="#6BC58B" Margin="0,0,9,0"/>
                                        <TextBlock Text="Salas privadas" FontSize="10" Foreground="#D0D5DC"/>
                                        <TextBlock Text="ATIVO" DockPanel.Dock="Right" FontSize="8"
                                                   FontWeight="Bold" Foreground="#6BC58B"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,7">
                                        <Ellipse Width="6" Height="6" Fill="#D6A45B" Margin="0,0,9,0"/>
                                        <TextBlock Text="Biblioteca de mods" FontSize="10" Foreground="#D0D5DC"/>
                                        <TextBlock Text="EM DESENVOLVIMENTO" DockPanel.Dock="Right"
                                                   FontSize="7" FontWeight="Bold" Foreground="#D6A45B"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="BottomPanel" Grid.Row="2" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Background="#D10D111A" BorderBrush="#394252" BorderThickness="1"
                                    CornerRadius="8" Padding="13" Margin="0,0,12,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="INSTALAÇÃO LOCAL" FontSize="8" FontWeight="Bold"
                                                   Foreground="#E76A73"/>
                                        <Button Content="ALTERAR PASTA" Click="ChooseFolder_Click"
                                                DockPanel.Dock="Right" FontSize="8" Padding="9,5"
                                                Margin="0" Background="#242C38"/>
                                    </DockPanel>
                                    <TextBox x:Name="GameFolderBox" IsReadOnly="True"
                                             VerticalContentAlignment="Center" Text="CAMINHO DA PASTA"
                                             Background="#11151D" BorderBrush="#303A49"
                                             FontSize="10" Padding="10,9"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#D10D111A" BorderBrush="#394252" BorderThickness="1"
                                    CornerRadius="8" Padding="13" Margin="0,10,12,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock Text="REGISTRO DE ATIVIDADE" FontSize="8"
                                                   FontWeight="Bold" Foreground="#E76A73"/>
                                        <TextBlock Text="LOCAL" DockPanel.Dock="Right" FontSize="8"
                                                   Foreground="#707C8D" FontWeight="Bold"/>
                                    </DockPanel>
                                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" MinHeight="54" MaxHeight="76"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="#AEB7C4" FontSize="9" FontFamily="Consolas"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#D10D111A" BorderBrush="#394252"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SESSÃO LOCAL" FontSize="8" FontWeight="Bold"
                                           Foreground="#8792A2"/>
                                <Border x:Name="GameStateBorder" Background="#555B66"
                                        CornerRadius="4" Padding="10,7" Margin="0,8,0,10">
                                    <TextBlock x:Name="GameStateLabel" Text="NENHUM" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                                <Button x:Name="PlayButton" Content="INICIAR JOGO"
                                        Style="{StaticResource PlayButton}" Click="Launch_Click"
                                        HorizontalContentAlignment="Center" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <ContentControl x:Name="PrivateMatchHost" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="FooterStatus" Text="Selecione a pasta do jogo para começar."
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="292,0,0,8"
                   Foreground="#929CAB" FontSize="9"/>

        <Border x:Name="WindowChrome" Opacity="0" Height="42" VerticalAlignment="Top"
                Margin="10,9,10,0" Background="#E10C0F16" BorderBrush="#343B49"
                BorderThickness="1" CornerRadius="8"
                MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                            IsHitTestVisible="False">
                    <Ellipse Width="6" Height="6" Fill="#E34450" Margin="0,0,9,0"/>
                    <TextBlock Text="REVIVAL REVOLUTION" FontSize="9" FontWeight="Bold"
                               Foreground="#D6DAE1" VerticalAlignment="Center"/>
                    <TextBlock Text="   /   COMMUNITY LAUNCHER" FontSize="8"
                               Foreground="#788393" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="42" Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" Click="MinimizeWindow_Click"
                            ToolTip="Minimizar"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Width="42" Margin="0" Padding="0"
                            HorizontalContentAlignment="Center" Background="Transparent"
                            BorderThickness="0" Click="MaximizeWindow_Click" ToolTip="Maximizar"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" Click="CloseWindow_Click"
                            ToolTip="Fechar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseSurface" Background="Transparent" CornerRadius="0,7,7,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#FFD93645"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#FF9D2632"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>