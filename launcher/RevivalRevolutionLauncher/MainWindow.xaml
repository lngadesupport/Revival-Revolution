<Window x:Class="RevivalRevolution.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Revival Revolution" Height="720" Width="1180" MinHeight="620" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#090B10" Foreground="#F4F5F7">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,18">
   <StackPanel><TextBlock Text="REVIVAL REVOLUTION" FontSize="25" FontWeight="Bold"/><TextBlock Text="METAL REVOLUTION • COMMUNITY LAUNCHER" Foreground="#9AA4B5" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   <TextBlock DockPanel.Dock="Right" Text="v0.6.0" Foreground="#9AA4B5" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#121722" CornerRadius="12" Padding="12" Margin="0,0,16,0">
    <StackPanel>
     <TextBlock Text="NAVEGAÇÃO" Foreground="#9AA4B5" FontSize="10" Margin="8,8,0,12"/>
     <Button Content="INÍCIO" Click="Home_Click"/><Button Content="INSTALAÇÃO / REPARO" Click="Install_Click"/>
     <Button Content="MULTIPLAYER" Click="Multiplayer_Click"/><Button Content="DIAGNÓSTICOS" Click="Diagnostics_Click"/>
     <Button Content="ATUALIZAÇÕES" Click="Updates_Click"/>
     <Separator Margin="4,18"/>
     <TextBlock Text="O launcher preserva os scripts e bridges existentes da distribuição." Foreground="#9AA4B5" TextWrapping="Wrap" Margin="8"/>
    </StackPanel>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Background="#121722" CornerRadius="12" Padding="24" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="BEM-VINDO DE VOLTA" Foreground="#E53945" FontWeight="Bold" FontSize="11"/>
       <TextBlock Text="Sua revolução começa aqui." FontSize="29" FontWeight="Bold" Margin="0,8,0,4"/>
       <TextBlock Text="Launcher comunitário para preparar e iniciar a instalação local de Metal Revolution." Foreground="#9AA4B5" TextWrapping="Wrap"/>
       <TextBlock Text="PASTA DO JOGO" Foreground="#9AA4B5" FontSize="10" FontWeight="Bold" Margin="0,24,0,6"/>
       <DockPanel><TextBox x:Name="GameFolderBox" Background="#090B10" Foreground="White" BorderBrush="#343D4D" Padding="10" IsReadOnly="True"/><Button Content="ESCOLHER PASTA" Click="ChooseFolder_Click"/></DockPanel>
       <WrapPanel Margin="0,16,0,0"><Button Content="JOGAR OFFLINE" Background="#B92835" Padding="24,12" Click="Launch_Click"/><Button Content="VERIFICAR INSTALAÇÃO" Click="Diagnostics_Click"/></WrapPanel>
      </StackPanel>
     </Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#121722" CornerRadius="12" Padding="18" Margin="0,0,7,0"><StackPanel><TextBlock Text="INSTALAÇÃO" FontWeight="Bold"/><TextBlock Text="Download e reparo dos pacotes são preparados pelos serviços do launcher. Confira os pacotes reais antes de distribuir." Foreground="#9AA4B5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#121722" CornerRadius="12" Padding="18" Margin="7,0,0,0"><StackPanel><TextBlock Text="MULTIPLAYER" FontWeight="Bold"/><TextBlock Text="O modo de conexão continua dependendo das bridges e scripts originais e permanece experimental." Foreground="#9AA4B5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
     </Grid>
     <Border Background="#121722" CornerRadius="12" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="ATIVIDADE" FontWeight="Bold"/><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" Background="#090B10" Foreground="#D9DEE8" BorderBrush="#343D4D" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="FooterStatus" Text="Selecione a pasta que contém ufo.exe." Foreground="#9AA4B5" Margin="2,14,0,0"/>
 </Grid>
</Window>