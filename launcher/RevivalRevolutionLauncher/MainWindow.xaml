<Window x:Class="RevivalRevolution.MainWindow"
        StateChanged="MainWindow_StateChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revival Revolution" Height="810" Width="1440"
        MinHeight="700" MinWidth="1100" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#080911" Foreground="#FFFFFF"
        FontFamily="pack://application:,,,/Assets/Fonts/#Bebas Neue">
    <Window.Resources>
        <SolidColorBrush x:Key="Glass" Color="#B00A0B17"/>
        <SolidColorBrush x:Key="Muted" Color="#C5C4D2"/>
        <SolidColorBrush x:Key="Red" Color="#D52D3B"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#7610182A"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B02B3149"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFE04A58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD9D1F2C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D5C21D2C"/>
            <Setter Property="BorderBrush" Value="#FFFF6671"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="35,16"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#7F080A13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Image x:Name="HeroBackground" Stretch="UniformToFill" Opacity="0.96"/>
        <Rectangle Fill="#38050916"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#AA070914" Offset="0"/>
                    <GradientStop Color="#22080B1C" Offset="0.48"/>
                    <GradientStop Color="#C9080710" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="MainContent" Margin="28,58,28,28" Opacity="0" Loaded="MainContent_Loaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0" Opacity="0" Background="#B30A0B18" BorderBrush="#33FFFFFF"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
                        <Button Content="LINK DISCORD" Click="Discord_Click" HorizontalContentAlignment="Center"
                                Background="#55202B43" Margin="0,0,0,4"/>
                        <TextBlock Text="REVIVAL REVOLUTION" FontSize="9" Foreground="#AEB2C2"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="#AEB2C2"
                                   Margin="8,4,0,16"/>
                        <Button x:Name="OfflineNavButton" Content="OFFLINE" Click="Launch_Click" FontSize="22" Padding="13,13"/>
                        <Button x:Name="PrivateMatchNavButton" Content="SALA POR CÓDIGO" Click="PrivateMatch_Click" FontSize="16" Padding="13,13"/>
                        <Button x:Name="ModListNavButton" Content="MOD LIST" Click="ModList_Click" FontSize="22" Padding="13,13"/>
                        <Separator Background="#55FFFFFF" Margin="4,20,4,14"/>
                        <Button x:Name="DiagnosticsNavButton" Content="DIAGNÓSTICOS" Click="Diagnostics_Click" FontSize="11"/>
                        <Button x:Name="SettingsNavButton" Content="CONFIGURAÇÕES" Click="Settings_Click" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="DashboardPage" Grid.Column="1" Margin="22,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel x:Name="HeaderPanel" Grid.Row="0" Opacity="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Image x:Name="MetalLogo" Width="190" Height="64" Stretch="Uniform" Visibility="Collapsed"/>
                        <StackPanel x:Name="LogoFallback">
                            <TextBlock Text="METAL" FontSize="34" FontWeight="Black" HorizontalAlignment="Right"
                                       Foreground="White"/>
                            <TextBlock Text="R E V O L U T I O N" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="#E7E5EC" Margin="0,-3,2,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#9B090A12" CornerRadius="6" Padding="12,7"
                            VerticalAlignment="Center" BorderBrush="#44FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="VersionLabel" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,22,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeroPanel" Grid.Column="0" Opacity="0" Background="#9B090A12" BorderBrush="#44FFFFFF"
                            BorderThickness="1" CornerRadius="16" Padding="28" Margin="0,0,18,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="REVIVAL REVOLUTION" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="Bold" Foreground="#FFE04A58"/>
                                <TextBlock Text="SUA ARENA. SEU COMBATE." FontSize="42" FontWeight="Black"
                                           Foreground="White" Margin="0,8,0,2"/>
                                <TextBlock Text="Launcher da comunidade • Inicialização offline preservada"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#D0CED8"/>
                            </StackPanel>
                            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,24,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#66161A2A" BorderBrush="#44FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="MODO OFFLINE" FontFamily="Segoe UI" FontSize="10"
                                                   FontWeight="Bold" Foreground="#BFC0CC"/>
                                        <TextBlock Text="PRONTO PARA JOGAR" FontSize="22" FontWeight="Bold"
                                                   Foreground="#FFFFFF" Margin="0,5,0,0"/>
                                        <TextBlock Text="Usa os scripts e bridges originais da distribuição."
                                                   FontFamily="Segoe UI" FontSize="10" Foreground="#C8C6D2"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#66161A2A" BorderBrush="#44FFFFFF"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="INSTALAÇÃO" FontFamily="Segoe UI" FontSize="10"
                                                   FontWeight="Bold" Foreground="#BFC0CC"/>
                                        <TextBlock x:Name="DashboardLocalStatus" Text="NÃO CONFIGURADA"
                                                   FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,5,0,0"/>
                                        <TextBlock Text="Diagnóstico local disponível. Reparos seguem protegidos."
                                                   FontFamily="Segoe UI" FontSize="10" Foreground="#C8C6D2"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="Selecione a instalação do jogo para habilitar o botão PLAY."
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#D0CED8"/>
                        </Grid>
                    </Border>
                    <Border x:Name="QuickAccessPanel" Grid.Column="1" Opacity="0" Background="#A0090A14" BorderBrush="#44FFFFFF"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ACESSO RÁPIDO" FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="Bold" Foreground="#BFC0CC" Margin="0,0,0,14"/>
                            <Button Content="LOCALIZAR JOGO" Click="ChooseFolder_Click"
                                    HorizontalContentAlignment="Center" FontSize="12" Padding="10,13"/>
                            <Button Content="RODAR DIAGNÓSTICO" Click="Diagnostics_Click"
                                    HorizontalContentAlignment="Center" FontSize="11" Padding="10,13"/>
                            <Separator Background="#55FFFFFF" Margin="2,12"/>
                            <TextBlock Text="RECURSOS" FontFamily="Segoe UI" FontSize="9"
                                       FontWeight="Bold" Foreground="#AEB2C2" Margin="0,4,0,6"/>
                            <TextBlock Text="• Offline disponível&#xA;• Private Match por convite&#xA;• Catálogo de mods pendente"
                                       FontFamily="Segoe UI" FontSize="10" Foreground="#C8C6D2"
                                       TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="BottomPanel" Grid.Row="2" Opacity="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameFolderBox" IsReadOnly="True" VerticalContentAlignment="Center"
                                     Text="CAMINHO DA PASTA" Background="#A0080A15" BorderBrush="#33FFFFFF"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="SELECIONE A PASTA" Click="ChooseFolder_Click"
                                    HorizontalContentAlignment="Center" FontSize="10" Margin="0"/>
                        </Grid>
                        <Border Background="#A0090A14" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="9" Padding="10">
                            <StackPanel>
                                <TextBlock Text="LOG" FontSize="10" FontWeight="Bold" Foreground="#DAD8E2"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" MinHeight="76" MaxHeight="130"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="#E6E4EC" FontSize="10" FontFamily="Segoe UI"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                        <Border x:Name="GameStateBorder" Background="#FF555B66" CornerRadius="8" Padding="12,7" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="GameStateLabel" Text="NENHUM" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="PlayButton" Content="PLAY" Style="{StaticResource PlayButton}" Click="Launch_Click"
                                HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <ContentControl x:Name="PrivateMatchHost" Grid.Column="1" Margin="22,0,0,0" Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="FooterStatus" Text="Selecione a pasta do jogo para começar."
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,12"
                   Foreground="#D1CEDA" FontSize="10" />

        <!-- Custom window chrome sits over the game artwork. -->
        <Border x:Name="WindowChrome" Opacity="0" Height="44" VerticalAlignment="Top" Margin="10,9,10,0"
                Background="#D9090D18" BorderBrush="#66FFFFFF" BorderThickness="1"
                CornerRadius="9" MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                            IsHitTestVisible="False">
                    <Ellipse Width="7" Height="7" Fill="#D52D3B" Margin="0,0,9,0"/>
                    <TextBlock Text="REVIVAL REVOLUTION  /  COMMUNITY LAUNCHER" FontFamily="Segoe UI" FontSize="9"
                               FontWeight="Bold" Foreground="#D9D8E2" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="44" Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" Click="MinimizeWindow_Click"
                            ToolTip="Minimizar"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Width="44" Margin="0" Padding="0"
                            HorizontalContentAlignment="Center" Background="Transparent"
                            BorderThickness="0" Click="MaximizeWindow_Click" ToolTip="Maximizar"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="48" Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" Click="CloseWindow_Click"
                            ToolTip="Fechar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseSurface" Background="Transparent" CornerRadius="0,8,8,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#FFD52D3B"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#FF9D1F2C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


    </Grid>
</Window>