<Window x:Class="RevivalRevolution.MainWindow"
        Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revival Revolution" Height="760" Width="1220"
        MinHeight="650" MinWidth="960" WindowStartupLocation="CenterScreen"
        Background="#090B10" Foreground="#F4F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121722"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA4B5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C52F3D"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#202A39"/>
            <Setter Property="Foreground" Value="#F4F5F7"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B3749"/>
                    <Setter Property="BorderBrush" Value="#596A82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#151C27"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#E04B57"/>
            <Setter Property="Padding" Value="22,12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#090B10"/>
            <Setter Property="Foreground" Value="#F4F5F7"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CaretBrush" Value="#F4F5F7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="REVIVAL REVOLUTION" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="METAL REVOLUTION  •  COMMUNITY LAUNCHER"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#171E2A" BorderBrush="#303A4A"
                    BorderThickness="1" CornerRadius="6" Padding="11,6" VerticalAlignment="Center">
                <TextBlock x:Name="VersionLabel" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    Padding="12" Margin="0,0,18,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,4">
                        <Separator Background="#303A4A" Margin="0,0,0,12"/>
                        <TextBlock Text="PROJETO COMUNITÁRIO" Foreground="#E04B57"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Preservamos o fluxo original do jogo e suas bridges. Nenhum componente proprietário é substituído."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   FontSize="11" LineHeight="17" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="NAVEGAÇÃO" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" Margin="8,8,0,12"/>
                        <Button Content="INÍCIO" Click="Home_Click" HorizontalContentAlignment="Left"/>
                        <Button Content="INSTALAÇÃO" Click="Install_Click" HorizontalContentAlignment="Left"/>
                        <Button Content="MULTIPLAYER" Click="Multiplayer_Click" HorizontalContentAlignment="Left"/>
                        <Button Content="DIAGNÓSTICOS" Click="Diagnostics_Click" HorizontalContentAlignment="Left"/>
                        <Button Content="ATUALIZAÇÕES" Click="Updates_Click" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12"
                            Padding="26" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="BEM-VINDO DE VOLTA" Foreground="#E04B57"
                                       FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Sua revolução começa aqui." FontSize="30"
                                       FontWeight="Bold" Margin="0,9,0,5"/>
                            <TextBlock Text="Prepare e inicie sua instalação local de Metal Revolution."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="PASTA DO JOGO" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="0,26,0,7"/>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="ESCOLHER PASTA"
                                        Click="ChooseFolder_Click" Margin="8,0,0,0"/>
                                <TextBox x:Name="GameFolderBox" IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel Margin="0,17,0,0">
                                <Button Content="JOGAR OFFLINE" Style="{StaticResource AccentButton}"
                                        Click="Launch_Click" Margin="0,0,8,0"/>
                                <Button Content="VERIFICAR INSTALAÇÃO" Click="Diagnostics_Click" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                CornerRadius="12" Padding="19" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="INSTALAÇÃO PROTEGIDA" FontWeight="Bold"/>
                                <TextBlock Text="Downloads e reparos estão temporariamente desativados até que os pacotes tenham hashes autenticados por uma fonte independente. Sua instalação atual não será sobrescrita."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,9,0,0" FontSize="11" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                                CornerRadius="12" Padding="19" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="MULTIPLAYER EXPERIMENTAL" FontWeight="Bold"/>
                                <TextBlock Text="A conexão depende das bridges e dos scripts originais. Compatibilidade entre máquinas e estabilidade online ainda precisam de testes."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,9,0,0" FontSize="11" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="19">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="ATIVIDADE" FontWeight="Bold"/>
                                <TextBlock Text="LOG DO LAUNCHER" DockPanel.Dock="Right"
                                           Foreground="{StaticResource MutedBrush}" FontSize="9"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                                     AcceptsReturn="True" MinHeight="135" MaxHeight="260"
                                     Background="#090B10" Foreground="#D9DEE8"
                                     BorderBrush="#303A4A" Margin="0,12,0,0"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="2,15,2,0">
            <TextBlock Text="REVIVAL REVOLUTION  •  WINDOWS X64" Foreground="#687487"
                       FontSize="9" VerticalAlignment="Center"/>
            <TextBlock x:Name="FooterStatus"
                       Text="Selecione a pasta que contém ufo.exe."
                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
