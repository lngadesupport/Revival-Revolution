<Window x:Class="RevivalRevolution.MainWindow"
        Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revival Revolution" Height="810" Width="1440"
        MinHeight="700" MinWidth="1100" WindowStartupLocation="CenterScreen"
        Background="#080911" Foreground="#FFFFFF">
    <Window.Resources>
        <SolidColorBrush x:Key="Glass" Color="#B00A0B17"/>
        <SolidColorBrush x:Key="Muted" Color="#C5C4D2"/>
        <SolidColorBrush x:Key="Red" Color="#D52D3B"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#7610182A"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B02B3149"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFE04A58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD9D1F2C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D5C21D2C"/>
            <Setter Property="BorderBrush" Value="#FFFF6671"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="35,16"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#7F080A13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Image x:Name="HeroBackground" Stretch="UniformToFill" Opacity="0.96"/>
        <Rectangle Fill="#38050916"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#AA070914" Offset="0"/>
                    <GradientStop Color="#22080B1C" Offset="0.48"/>
                    <GradientStop Color="#C9080710" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B30A0B18" BorderBrush="#33FFFFFF"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
                        <Button Content="LINK DISCORD" Click="Discord_Click" HorizontalContentAlignment="Center"
                                Background="#55202B43" Margin="0,0,0,4"/>
                        <TextBlock Text="REVIVAL REVOLUTION" FontSize="9" Foreground="#AEB2C2"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="#AEB2C2"
                                   Margin="8,4,0,16"/>
                        <Button Content="OFFLINE" Click="Launch_Click" FontSize="22" Padding="13,13"/>
                        <Button Content="ONLINE" Click="Multiplayer_Click" FontSize="22" Padding="13,13"/>
                        <Button Content="PRIVATE MATCH" Click="PrivateMatch_Click" FontSize="16" Padding="13,13"/>
                        <Button Content="MOD LIST" Click="ModList_Click" FontSize="22" Padding="13,13"/>
                        <Separator Background="#55FFFFFF" Margin="4,20,4,14"/>
                        <Button Content="DIAGNÓSTICOS" Click="Diagnostics_Click" FontSize="11"/>
                        <Button Content="ATUALIZAÇÕES" Click="Updates_Click" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Image x:Name="MetalLogo" Width="190" Height="64" Stretch="Uniform" Visibility="Collapsed"/>
                        <StackPanel x:Name="LogoFallback">
                            <TextBlock Text="METAL" FontSize="34" FontWeight="Black" HorizontalAlignment="Right"
                                       Foreground="White"/>
                            <TextBlock Text="R E V O L U T I O N" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="#E7E5EC" Margin="0,-3,2,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#9B090A12" CornerRadius="6" Padding="12,7"
                            VerticalAlignment="Center" BorderBrush="#44FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="VersionLabel" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,18">
                        <Border Background="#B30B0B14" CornerRadius="8" Padding="12,7" HorizontalAlignment="Stretch">
                            <TextBlock Text="JOGO PREPARADO" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <Button Content="PLAY" Style="{StaticResource PlayButton}" Click="Launch_Click"
                                HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,210,0">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameFolderBox" IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="CAMINHO DA PASTA" Background="#A0080A15" BorderBrush="#33FFFFFF"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="SELECIONE A PASTA" Click="ChooseFolder_Click"
                                HorizontalContentAlignment="Center" FontSize="10" Margin="0"/>
                    </Grid>
                    <Border Background="#A0090A14" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="9" Padding="10">
                        <StackPanel>
                            <TextBlock Text="LOG" FontSize="10" FontWeight="Bold" Foreground="#DAD8E2"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                                     AcceptsReturn="True" MinHeight="76" MaxHeight="130"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="#E6E4EC" FontSize="10"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock x:Name="FooterStatus" Text="Selecione a pasta do jogo para começar."
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,12"
                   Foreground="#D1CEDA" FontSize="10" />
    </Grid>
</Window>